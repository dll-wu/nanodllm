include .github/workflows/quality.yml
include AGENTS.md
include CITATION.cff
include CONTRIBUTING.md
include DESIGN_DECISIONS.md
include LICENSE
include README.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
include pyproject.toml
include pretrain.py

recursive-include configs *.json
recursive-include paper_results *.py *.json *.tex *.md
recursive-include evaluation *.json *.md
recursive-include docs *.md
recursive-include examples *.txt
recursive-include nanodllm *.py
include nanodllm/paper_runtime/vendor/nanochat/LICENSE
recursive-include scripts *.py
recursive-include tests *.py

prune .mypy_cache
prune .pytest_cache
prune .ruff_cache
prune .venv
prune build
prune data
prune dist
prune reports
prune results
prune runs
prune venv
prune nano_dllm.egg-info

global-exclude .DS_Store
global-exclude *.ckpt
global-exclude *.py[cod]
global-exclude *.pt
global-exclude *.pth
global-exclude *.tmp
global-exclude __pycache__
global-exclude events.out.tfevents.*
