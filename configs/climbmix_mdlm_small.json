{
  "model": {
    "depth": 8,
    "n_embd": 512,
    "n_head": 8,
    "max_seq_len": 1024,
    "mlp_hidden_dim": 2048,
    "attention_scale": 0.125,
    "rope_base": 100000.0,
    "pad_vocab_to": 64,
    "local_attention_lower_layers": 0,
    "local_attention_window": 0,
    "auxiliary_head_layers": [],
    "output_factorization": "flat",
    "causal": false,
    "residual_output_projection_init": "zero",
    "embedding_head_init_std_multiplier": 1.0
  },
  "data": {
    "tokenizer": "hf",
    "tokenizer_path": "${NANODLLM_TOKENIZER_DIR}",
    "train_data": ["${NANODLLM_DATA_DIR}"],
    "train_exclude_data": [],
    "val_data": [],
    "text_column": "text",
    "val_fraction": 0.02,
    "tokenizer_batch_size": 128,
    "prepend_bos": false,
    "append_eos": true,
    "loss_on_bos": false,
    "loss_on_eos": true,
    "random_length_ratio": 0.01,
    "random_length_min": 1,
    "continuation_ratio": 0.1,
    "continuation_min_prefix_frac": 0.125,
    "continuation_max_prefix_frac": 0.75,
    "shuffle_row_groups": true,
    "shuffle_seed": 1337,
    "boundary_aware_packing": false,
    "content_budget_segmented_packing": false,
    "short_document_curriculum": false,
    "identity_mode": "metadata"
  },
  "noise": {
    "type": "mdlm",
    "t_min": 0.05,
    "t_max": 0.95,
    "schedule_weight": true,
    "complement_masking": true,
    "per_token_noise_levels": false,
    "time_conditioning": false,
    "suffix_masking": false
  },
  "optim": {
    "type": "adamw",
    "lr": 0.0003,
    "weight_decay": 0.1,
    "adam_beta1": 0.9,
    "adam_beta2": 0.95,
    "adam_eps": 1e-8,
    "warmup_steps": 100,
    "warmup_ratio": -1.0,
    "warmdown_ratio": 0.2,
    "final_lr_frac": 0.1,
    "grad_clip": 1.0
  },
  "runtime": {
    "device_type": "cuda",
    "dtype": "bfloat16",
    "seed": 1337,
    "model_seed": 1337,
    "training_seed": 1337,
    "compile": true,
    "compile_dynamic": false,
    "min_free_gpu_mib": 0,
    "float32_matmul_precision": "high",
    "allow_tf32": true,
    "cudnn_allow_tf32": true,
    "cudnn_benchmark": false,
    "deterministic_algorithms": false,
    "sdpa_backend": "auto"
  },
  "train": {
    "run_dir": "runs/climbmix_mdlm_small",
    "num_steps": 1000,
    "target_tokens": -1,
    "target_param_data_ratio": 12.0,
    "target_param_count_basis": "nanochat_scaling_parameters",
    "total_batch_size": 65536,
    "device_batch_size": 2,
    "base_total_batch_size": 65536,
    "allow_batch_size_round_up": false,
    "scale_lr_by_batch": false,
    "log_interval": 10,
    "tensorboard": true,
    "save_every": 250,
    "eval_every": 250,
    "resume_from": ""
  },
  "eval": {
    "enabled": true,
    "gen_eval": false,
    "gen_eval_periodic": false,
    "gen_score_mode": "self",
    "nelbo_tokens": 1048576,
    "fixed_ce_batches": 5,
    "reconstruction_eval": true,
    "reconstruction_batches": 2,
    "reconstruction_t_values": [0.7, 0.9],
    "reconstruction_log_samples": 3,
    "conditional_rank_eval": true,
    "conditional_rank_batches": 5,
    "sample_steps": 64,
    "sample_trace": false
  },
  "recipe": {
    "name": "climbmix-mdlm-small",
    "status": "provisional",
    "locked_fields": [
      "model.depth",
      "model.n_embd",
      "model.n_head",
      "model.max_seq_len",
      "model.causal",
      "data.tokenizer",
      "noise.type",
      "noise.schedule_weight",
      "noise.time_conditioning"
    ],
    "provisional_fields": [
      "data.tokenizer_path",
      "data.train_data",
      "data.val_fraction",
      "optim.lr",
      "train.num_steps",
      "train.total_batch_size",
      "train.device_batch_size",
      "eval.nelbo_tokens"
    ]
  }
}
